# syntax=docker/dockerfile:1
# ==============================================================================
# TontOS AOSP ROM Native Builder (Debian Slim)
# Ultra-lightweight (28MB base) glibc container tested and verified for AOSP 16 (BP4A).
# Maintainer: FalseThinks <paproken@protonmail.com>
# ==============================================================================

FROM debian:bookworm-slim

LABEL maintainer="FalseThinks <paproken@protonmail.com>"
LABEL description="Ultra-lightweight glibc builder for TontOS AOSP ROM"

ENV DEBIAN_FRONTEND=noninteractive

# 1. Install required platform build tools
RUN apt-get update -qq && apt-get install -qq -y --no-install-recommends \
    bash \
    coreutils \
    git \
    git-lfs \
    curl \
    python3 \
    python3-dev \
    openjdk-17-jdk-headless \
    ccache \
    rsync \
    zip \
    unzip \
    bison \
    flex \
    bc \
    m4 \
    make \
    gcc \
    g++ \
    ca-certificates \
    procps \
    sudo \
    jq \
    && rm -rf /var/lib/apt/lists/*

# 2. Install Google repo tool
RUN curl -s https://storage.googleapis.com/git-repo-downloads/repo > /usr/local/bin/repo && \
    chmod a+rx /usr/local/bin/repo

# 3. Create non-root build user matching host UID/GID (1000:1000)
RUN groupadd -g 1000 tontos && \
    useradd -u 1000 -g tontos -m -s /bin/bash tontos && \
    echo "tontos ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# 4. Environment configuration for AOSP & Soong
ENV USER=tontos
ENV HOME=/home/tontos
ENV LANG=C.UTF-8
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH=/usr/lib/ccache:/usr/local/bin:/usr/bin:/bin:$PATH
ENV USE_CCACHE=1
ENV CCACHE_DIR=/home/tontos/.ccache
ENV CCACHE_EXEC=/usr/bin/ccache
ENV SOONG_JOBS=1

USER tontos
WORKDIR /home/tontos/aosp

CMD ["/bin/bash"]
